# Copy to .env locally, add to GitHub Secrets for Actions (no Buffer)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini # score uses mini, synthesize uses gpt-4o
GEMINI_API_KEY=AIza... # Gemini 1.5 Flash free tier (aistudio.google.com/app/apikey) - preferred free
TAVILY_API_KEY=tvly-...

# X via Ayrshare (headless, no Buffer) — 1 API key, 20 posts/mo free
AYRSHARE_API_KEY=your_ayrshare_bearer # https://app.ayrshare.com -> API Key
AYRSHARE_PLATFORMS=twitter # for X only; add linkedin,facebook if needed
# Optional: direct X API v2 (alternative to Ayrshare, paid $200/mo) — leave blank if using Ayrshare
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# 30d human gate via Telegram (same as Substack)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
# Gate: 0 = human approve (Telegram APPROVE/REJECT), 1 = auto headless after 12 approved (~30d)
AUTO_PUBLISH=0
